{% sw_extends '@Storefront/storefront/page/checkout/summary.html.twig' %}

{#
    Deliveries to other countries become separate orders (setting countryMode).
    The confirm page then shows each order's own totals - taxes and shipping
    calculated for its country - and what the customer pays in total.
#}
{% block page_checkout_summary_inner %}
    {# Confirm page: the carts each order will be placed with. Finish page: the placed orders. #}
    {% if page.cart %}
        {% set mnSeparate = page.extensions.mnMultiDelivery.separateOrders|default(null) %}
    {% else %}
        {% set mnSeparate = page.extensions.mnSeparateOrders|default(null) %}
    {% endif %}
    {% if mnSeparate and mnSeparate.orders|length > (page.cart ? 0 : 1) %}
        {% for mnOrder in mnSeparate.orders %}
            {% block page_checkout_summary_mn_separate_order %}
                {% if page.cart %}
                    {% set summary = mnOrder.cart %}
                    {% set mnHeading = 'mnMultiDelivery.separate.orderHeading'|trans({
                        '%number%': loop.index,
                        '%country%': mnOrder.country.translated.name|default(''),
                    }) %}
                {% else %}
                    {% set summary = mnOrder %}
                    {% set mnFirstDelivery = mnOrder.deliveries.first|default(null) %}
                    {% set mnHeading = 'mnMultiDelivery.separate.finishOrderHeading'|trans({
                        '%number%': mnOrder.orderNumber,
                        '%country%': mnFirstDelivery ? mnFirstDelivery.shippingOrderAddress.country.translated.name : '',
                    }) %}
                {% endif %}
                <dt class="col-12 checkout-aside-summary-label mn-md-order-heading">{{ mnHeading|sw_sanitize }}</dt>
                {% sw_include '@Storefront/storefront/page/checkout/summary/summary-position.html.twig' with { summary: summary, isoCode: isoCode } %}
                {% sw_include '@Storefront/storefront/page/checkout/summary/summary-shipping.html.twig' with { summary: summary, isoCode: isoCode } %}
                {% if summary.price.taxStatus == 'gross' %}
                    {% sw_include '@Storefront/storefront/page/checkout/summary/summary-total.html.twig' with { total: summary.price.totalPrice, decimals: decimals, isoCode: isoCode } %}
                    {% sw_include '@Storefront/storefront/page/checkout/summary/summary-tax.html.twig' with { summary: summary, isoCode: isoCode } %}
                {% else %}
                    {% sw_include '@Storefront/storefront/page/checkout/summary/summary-net.html.twig' with { summary: summary, isoCode: isoCode } %}
                    {% sw_include '@Storefront/storefront/page/checkout/summary/summary-tax.html.twig' with { summary: summary, isoCode: isoCode } %}
                    {% sw_include '@Storefront/storefront/page/checkout/summary/summary-total.html.twig' with { total: summary.price.totalPrice, decimals: decimals, isoCode: isoCode } %}
                {% endif %}
            {% endblock %}
        {% endfor %}

        {% block page_checkout_summary_mn_separate_total %}
            <dt class="col-7 checkout-aside-summary-label checkout-aside-summary-total mn-md-grand-total">
                {{ 'mnMultiDelivery.separate.grandTotal'|trans({'%count%': mnSeparate.orders|length})|sw_sanitize }}
            </dt>
            <dd class="col-5 checkout-aside-summary-value checkout-aside-summary-total mn-md-grand-total">
                {{ mnSeparate.totalPrice|currency(isoCode) }}
            </dd>
        {% endblock %}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}
