{
    "openapi": "3.2.0",
    "info": [],
    "paths": [],
    "components": {
        "schemas": {
            "MnMultiDelivery": {
                "type": "object",
                "description": "State of the delivery planner for the current cart.",
                "required": [
                    "apiAlias",
                    "plan",
                    "strategies",
                    "strategy",
                    "manualMoves",
                    "adjustable",
                    "adjusted",
                    "manualGroups",
                    "moveTargets",
                    "groupNumbers",
                    "shippingCountryId",
                    "addressIds",
                    "separateOrders"
                ],
                "properties": {
                    "apiAlias": {
                        "type": "string",
                        "enum": [
                            "mn_multi_delivery"
                        ]
                    },
                    "plan": {
                        "$ref": "#/components/schemas/MnDeliveryPlan"
                    },
                    "blockReason": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Why the cart can not be split (disabled, empty, quote, subscription, recalculation, payment, or a project-specific reason), null when it can."
                    },
                    "strategies": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Splitting rules the customer may choose, e.g. manual, availability, deliveryTime, warehouse."
                    },
                    "strategy": {
                        "type": "string",
                        "description": "Active splitting rule."
                    },
                    "manualMoves": {
                        "type": "boolean",
                        "description": "The customer creates the deliveries (add-group/remove-group are available)."
                    },
                    "adjustable": {
                        "type": "boolean",
                        "description": "Items may be moved within the automatic split."
                    },
                    "adjusted": {
                        "type": "boolean",
                        "description": "The customer moved items within the automatic split (reset is available)."
                    },
                    "manualGroups": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "moveTargets": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Group ids items can be moved to."
                    },
                    "groupNumbers": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "integer"
                        },
                        "description": "Display number per group id."
                    },
                    "shippingCountryId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{32}$",
                        "description": "The shipping country. Addresses in other countries are offered only when separateOrders.paymentAllowed is true."
                    },
                    "addressIds": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{32}$"
                        },
                        "description": "Customer addresses a delivery may use."
                    },
                    "separateOrders": {
                        "type": "object",
                        "description": "Separate orders (setting countryMode: separateOrders = hybrid, only deliveries to other countries; allSeparate = every delivery). When the cart has some, orders lists every order the checkout will place: the separate orders first, the main order last.",
                        "required": [
                            "enabled",
                            "paymentAllowed",
                            "orders",
                            "totalPrice"
                        ],
                        "properties": {
                            "enabled": {
                                "type": "boolean",
                                "description": "The merchant allows separate orders (countryMode separateOrders or allSeparate)."
                            },
                            "mode": {
                                "type": "string",
                                "enum": ["sameCountry", "separateOrders", "allSeparate"],
                                "description": "The countryMode setting."
                            },
                            "separateGroupIds": {
                                "type": "array",
                                "items": { "type": "string" },
                                "description": "Delivery groups that become separate orders; empty when orders is empty."
                            },
                            "paymentAllowed": {
                                "type": "boolean",
                                "description": "The selected payment method allows separate orders."
                            },
                            "totalPrice": {
                                "type": "number",
                                "description": "Sum of all orders' totals; 0 when orders is empty."
                            },
                            "orders": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "required": [
                                        "main",
                                        "countryId",
                                        "lineItems",
                                        "positionPrice",
                                        "shippingCosts",
                                        "netPrice",
                                        "totalPrice",
                                        "taxStatus",
                                        "calculatedTaxes",
                                        "blockingErrors"
                                    ],
                                    "properties": {
                                        "main": {
                                            "type": "boolean",
                                            "description": "The main order (shipping country)."
                                        },
                                        "groupId": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "description": "Delivery group of a separate order, null for the main order."
                                        },
                                        "addressId": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "description": "Delivery address of a separate order, null for the main order."
                                        },
                                        "countryId": {
                                            "type": "string",
                                            "pattern": "^[0-9a-f]{32}$"
                                        },
                                        "lineItems": {
                                            "type": "object",
                                            "additionalProperties": {
                                                "type": "integer"
                                            },
                                            "description": "Quantity per top-level cart item id."
                                        },
                                        "positionPrice": {
                                            "type": "number"
                                        },
                                        "shippingCosts": {
                                            "type": "number"
                                        },
                                        "netPrice": {
                                            "type": "number"
                                        },
                                        "totalPrice": {
                                            "type": "number"
                                        },
                                        "taxStatus": {
                                            "type": "string"
                                        },
                                        "calculatedTaxes": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "taxRate": {
                                                        "type": "number"
                                                    },
                                                    "tax": {
                                                        "type": "number"
                                                    }
                                                }
                                            }
                                        },
                                        "blockingErrors": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            },
                                            "description": "Message keys of errors that would stop this order from being placed."
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "MnDeliveryPlan": {
                "type": "object",
                "properties": {
                    "apiAlias": {
                        "type": "string",
                        "enum": [
                            "mn_delivery_plan"
                        ]
                    },
                    "enabled": {
                        "type": "boolean"
                    },
                    "strategy": {
                        "type": "string"
                    },
                    "groups": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "object",
                            "properties": {
                                "addressId": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "shippingMethodId": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                }
                            }
                        },
                        "description": "Address and shipping method per group id."
                    },
                    "assignments": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "integer"
                            }
                        },
                        "description": "Manual rule: line item id => group id => quantity."
                    },
                    "manualGroups": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "adjustments": {
                        "type": "object",
                        "description": "Automatic rules: strategy => line item id => group id => quantity."
                    }
                }
            }
        }
    }
}
